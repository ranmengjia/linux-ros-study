<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">
    <xacro:property name="base_length" value="0.30"/>
    <xacro:property name="base_width" value="0.12"/>
    <xacro:property name="base_height" value="0.16"/>
    <xacro:property name="laser_x" value="0.10"/>
    <xacro:property name="laser_z" value="${base_height/2 + 0.08}"/>
    <xacro:property name="wheel_radius" value="0.032"/>
    <xacro:property name="wheel_thickness" value="0.02"/>
    <xacro:property name="wheel_offset_y" value="0.075"/>
    <xacro:property name="caster_radius" value="0.01"/>
    <xacro:property name="caster_z" value="${-base_height/2 + caster_radius}"/>
    <xacro:property name="imu_length" value="0.02"/>
    <xacro:property name="imu_width" value="0.02"/>
    <xacro:property name="imu_height" value="0.01"/>
    <xacro:property name="imu_z" value="${base_height/2 + 0.02}"/>
    <xacro:property name="imu_x" value="0.0"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.0" rpy="0 0 0.0"/>
            <geometry>
            <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.0" rpy="0 0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="2.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0267" ixy="0.0" ixz="0.0" iyy="0.0267" iyz="0.0" izz="0.0267"/>
        </inertial>
    </link>

    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 0.0" rpy="0 0 0.0"/>
            <geometry>
                <cylinder length="0.05" radius="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.0" rpy="0 0 0.0"/>
            <geometry>
                <cylinder length="0.05" radius="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.000031" ixy="0.0" ixz="0.0" iyy="0.000031" iyz="0.0" izz="0.00002"/>
        </inertial>
    </link>

    <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${laser_x} 0 ${laser_z}" rpy="0 0 0"/>
    </joint>

<xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="${name}_wheel_link"/>
    <origin xyz="0 ${y} ${-base_height/2 + wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    </joint>
</xacro:macro>

<xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0000004" ixy="0.0" ixz="0.0" iyy="0.0000004" iyz="0.0" izz="0.0000004"/>
        </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="${name}_caster_link"/>
    <origin xyz="${x} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>
</xacro:macro>

<link name="imu_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00000042" ixy="0.0" ixz="0.0" iyy="0.00000042" iyz="0.0" izz="0.00000042"/>
    </inertial>
</link>
<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} 0 ${imu_z}" rpy="0 0 0"/>
</joint>

<xacro:wheel name="left" y="0.075"/>
<xacro:wheel name="right" y="-0.075"/>

<xacro:caster name="front" x="0.13"/>
<xacro:caster name="back" x="-0.13"/>

<gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <wheel_separation>0.15</wheel_separation>
        <wheel_diameter>0.064</wheel_diameter>

        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>1.0</max_wheel_acceleration>

        <command_topic>cmd_vel</command_topic>

        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
    </plugin>
</gazebo>

<gazebo reference="laser_frame">
    <sensor name="laser_sensor" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>5</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.10</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>
            <noise>
                <type>Gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </ray>
        <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
            <ros>
                <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>laser_frame</frame_name>
        </plugin>
    </sensor>
</gazebo>

</robot>
